{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python --version)",
      "Bash(python -m pytest *)",
      "Bash(python -m mutmut *)",
      "Bash(ruff check *)",
      "Bash(ruff format --check *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git commit --amend*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)"
    ]
  }
}
